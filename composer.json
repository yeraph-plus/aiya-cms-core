{
    "name": "aiya/aiya-core",
    "description": "Headless-first administration and content framework for AIYA CMS.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "aiya/slug-toolkit": "@dev",
        "aiya/image-processor": "@dev"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^11.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-cli/i18n-command": "^2.6"
    },
    "repositories": {
        "packages": {
            "type": "path",
            "url": "packages/*"
        },
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.cloud.tencent.com/composer/"
        }
    },
    "scripts": {
        "php:lint": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
        "php:cs": "@php ./vendor/bin/phpcs",
        "php:cbf": "@php ./vendor/bin/phpcbf",
        "php:stan": "@php ./vendor/bin/phpstan analyse --memory-limit=4G",
        "php:unit": "@php ./vendor/bin/phpunit",
        "i18n:pot": "@php ./vendor/wp-cli/wp-cli/php/boot-fs.php --allow-root i18n make-pot . languages/aiya-core.pot --domain=aiya-core --exclude=vendor,node_modules,.git,docs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}

msgstr "单帖最多携带九张图片。"

msgid "The thread could not be stored."
msgstr "线程保存失败。"

msgid "The board slug must be lowercase letters, digits, dashes or underscores."
msgstr "板块别名仅限小写字母、数字、中划线与下划线。"

msgid "The board name is required."
msgstr "板块名称不能为空。"

msgid "A board with this slug already exists."

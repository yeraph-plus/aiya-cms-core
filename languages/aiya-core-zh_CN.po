msgid "Unknown thread status."
msgstr "未知线程状态。"

msgid "The thread could not be updated."
msgstr "线程更新失败。"

msgid "You are not allowed to delete this thread."
msgstr "您无权删除该线程。"

msgid "The thread replies could not be deleted."
msgstr "线程回复删除失败。"

msgid "The thread could not be deleted."
msgstr "线程删除失败。"

msgid "Reply not found."
msgstr "回复不存在。"

msgid "You are not allowed to edit this reply."
msgstr "您无权编辑该回复。"

msgid "The reply could not be updated."
msgstr "回复无法更新。"

msgid "You are not allowed to delete this reply."
msgstr "您无权删除该回复。"

msgid "The reply could not be deleted."
msgstr "回复删除失败。"

msgid "The bound content does not exist or cannot carry discussions."
msgstr "绑定的内容不存在或不能承载讨论。"


# Dependencies
vendor/
# assets/vendor/ is the vendored runtime payload that ships inside the plugin
# package (Chart.js and its license). The bare `vendor/` rule above is
# unanchored, so it swallows that directory as well — let it back in.
!/assets/vendor/
node_modules/

# Build artifacts
*.zip
*.mo

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime artifacts (never commit local WP data)
*.log

# Contract snapshot scratch output (sync tool workspace artifact)
/backend-snap.json

# Local dev-only helper: runs the suite on the container-native disk
# (the Windows bind mount silently truncates phpunit discovery).
scripts/test-native.sh
